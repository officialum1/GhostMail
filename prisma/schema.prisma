generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int         @id @default(autoincrement())
  username   String      @unique
  email      String      @unique
  password   String
  createdAt  DateTime    @default(now())
  isBanned   Boolean     @default(false)
  lastActive DateTime?
  emails     Email[]
  bannedUser BannedUser?

  // Analytics groups signups by day over a trailing range.
  @@index([createdAt])
  @@index([isBanned])
}

model Email {
  id           Int      @id @default(autoincrement())
  toAddress    String
  fromAddress  String
  subject      String
  bodyText     String   @db.Text
  bodyHtml     String?  @db.Text
  receivedAt   DateTime @default(now())
  rawHeaders   String?  @db.Text
  isRead       Boolean  @default(false)
  sent         Boolean  @default(false)
  deletedAt    DateTime?
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  // Inbox listing: filter by owner + not-deleted, sort by date.
  @@index([userId, deletedAt, receivedAt])
  // Admin listing and retention cleanup both scan on date alone.
  @@index([receivedAt])
  // Inbound delivery resolves the mailbox by recipient address.
  @@index([toAddress])
}

model Admin {
  id                 Int        @id @default(autoincrement())
  email              String     @unique
  password           String
  createdAt          DateTime   @default(now())
  twoFactorSecret    String?
  twoFactorEnabled   Boolean    @default(false)
  auditLogs          AuditLog[]
}

model BannedUser {
  id       Int      @id @default(autoincrement())
  userId   Int      @unique
  reason   String?
  bannedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BlacklistedUsername {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  createdAt DateTime @default(now())
}

model BlacklistedDomain {
  id        Int      @id @default(autoincrement())
  domain    String   @unique
  createdAt DateTime @default(now())
}

model WebhookLog {
  id          Int      @id @default(autoincrement())
  toAddress   String
  fromAddress String
  status      String
  error       String?
  receivedAt  DateTime @default(now())

  @@index([status])
  @@index([receivedAt])
}

model FailedLoginAttempt {
  id          Int      @id @default(autoincrement())
  email       String
  ip          String?
  attemptedAt DateTime @default(now())

  // The security dashboard counts attempts in a trailing window.
  @@index([attemptedAt])
  @@index([email, attemptedAt])
}

model AdminSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  type      String
  message   String
  metadata  String?  @db.Text
  userId    Int?
  ip        String?
  createdAt DateTime @default(now())

  @@index([type])
  @@index([createdAt])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  adminId   Int
  action    String
  target    String?
  details   String?  @db.Text
  ip        String?
  createdAt DateTime @default(now())
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([createdAt])
}

model SuspiciousActivity {
  id          Int      @id @default(autoincrement())
  type        String
  description String
  ip          String?
  userId      Int?
  severity    String
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([resolved])
  @@index([severity])
}

model IpBlacklist {
  id        Int      @id @default(autoincrement())
  ip        String   @unique
  reason    String?
  createdAt DateTime @default(now())
}

model AnnouncementBanner {
  id        Int      @id @default(autoincrement())
  message   String
  color     String   @default("blue")
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
}
