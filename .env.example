DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"
NEXTAUTH_SECRET="replace-with-strong-random-secret"
NEXTAUTH_URL="http://localhost:3000"
DOMAIN="yourdomain.com"
NEXT_PUBLIC_DOMAIN="yourdomain.com"
WEBHOOK_SECRET="replace-with-webhook-secret"
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="replace-with-strong-password"
SETUP_TOKEN="replace-with-admin-setup-token-min-16-chars"

# Optional: Outbound SMTP configuration (required if using compose/send from dashboard)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="smtp-username"
SMTP_PASS="smtp-password"

# Optional: Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
